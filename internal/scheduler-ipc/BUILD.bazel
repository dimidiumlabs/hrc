load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(["BUILD.bazel"])

go_library(
    name = "scheduler-ipc",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/internal/scheduler-ipc",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/provider",
        "//internal/slot",
        "//internal/space",
    ],
)

go_test(
    name = "scheduler-ipc_test",
    srcs = glob(["*_test.go"]),
    embed = [":scheduler-ipc"],
    deps = [
        "//internal/provider",
        "//internal/space",
    ],
)
