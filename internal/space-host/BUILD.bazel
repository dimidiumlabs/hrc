load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(["BUILD.bazel"])

go_library(
    name = "space-host",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/internal/space-host",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/scheduler-ipc",
        "//internal/space",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "space-host_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":space-host"],
    deps = [
        "//internal/provider",
        "//internal/scheduler-ipc",
        "//internal/space",
    ],
)
