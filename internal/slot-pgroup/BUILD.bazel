load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/check:sources.bzl", "check_sources")

check_sources()

go_library(
    name = "slot-pgroup",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/internal/slot-pgroup",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/runtime",
        "//internal/slot",
    ],
)

go_test(
    name = "slot-pgroup_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":slot-pgroup"],
    deps = [
        "//internal/provider",
        "//internal/slot",
    ],
)
