load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/check:sources.bzl", "check_sources")

check_sources()

copy_file(
    name = "runner_version",
    src = "@actions_runner//:runnerversion",
    out = "runner-version.txt",
)

go_library(
    name = "provider-github",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    embedsrcs = [":runner_version"],
    importpath = "dimidiumlabs.io/hrc/internal/provider-github",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/provider-github/listener",
        "//internal/provider-github/worker",
        "@com_github_actions_scaleset//:scaleset",
        "@com_github_golang_jwt_jwt_v5//:jwt",
    ],
)

go_test(
    name = "provider-github_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":provider-github"],
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/provider-github/listener",
        "//internal/provider-github/worker",
        "@com_github_actions_scaleset//:scaleset",
        "@com_github_golang_jwt_jwt_v5//:jwt",
    ],
)
