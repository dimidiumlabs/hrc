load("//tools:tools.bzl", "export_tool")
load(":linter.bzl", "buildifier_file", "gofmt_file")
load(":sources.bzl", "check_sources")

check_sources(sh = ["*.sh"])

buildifier_file(name = "buildifier_sdk")

export_tool(
    name = "buildifier",
    src = ":buildifier_sdk",
    visibility = ["//visibility:public"],
)

export_tool(
    name = "buildifier_lint",
    src = ":buildifier",
    wrapper = "buildifier_lint.sh",
    visibility = ["//visibility:public"],
)

export_tool(
    name = "shellcheck",
    src = "@aspect_rules_lint//lint:shellcheck_bin",
    visibility = ["//visibility:public"],
)

gofmt_file(name = "gofmt_sdk")

export_tool(
    name = "gofmt",
    src = ":gofmt_sdk",
    visibility = ["//visibility:public"],
)

export_tool(
    name = "ruff",
    src = "@aspect_rules_lint//format:ruff",
    visibility = ["//visibility:public"],
)

exports_files([
    ".shellcheckrc",
    "ruff.toml",
])

exports_files(
    ["format.py"],
    visibility = ["//:__pkg__"],
)
