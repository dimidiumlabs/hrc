load("//tools:tools.bzl", "export_tool")
load("//tools/check:sources.bzl", "check_sources")
load(":sdk.bzl", "go_sdk_file")

check_sources(
    sh = ["*.sh"],
)

go_sdk_file(name = "go_sdk")

export_tool(
    name = "go",
    src = ":go_sdk",
)

# The Renovate job and its bootstrap artifacts are Linux/amd64 only.
export_tool(
    name = "node",
    src = "@node24_linux_glibc_x64//:node_bin",
)
