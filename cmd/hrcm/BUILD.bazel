load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/check:sources.bzl", "check_sources")

check_sources()

go_library(
    name = "hrcm_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),  # keep
    importpath = "dimidiumlabs.io/hrc/cmd/hrcm",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/runtime",
        "//internal/slot",
        "//internal/slot-pgroup",
        "//internal/space",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_binary(
    name = "hrcm",
    embed = [":hrcm_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "hrcm_test",
    size = "small",
    srcs = glob(["*_test.go"]),  # keep
    embed = [":hrcm_lib"],
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/slot",
        "//internal/space",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
    ],
)
