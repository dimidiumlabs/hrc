load("@rules_go//go:def.bzl", "go_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//tools/check:sources.bzl", "check_sources")

check_sources()

py_binary(
    name = "local",
    srcs = ["local.py"],
    data = [
        "//:hrcd",
        "//:hrcm",
        "//cmd/hrcp-forgejo/queue",
        "//cmd/hrcp-forgejo/worker",
        "@forgejo_test_server//file",
        "@node20_linux_glibc_x64//:node_bin",
        "@node24_linux_glibc_x64//:node_bin",
    ],
    env = {
        "FORGEJO_QUEUE": "$(rlocationpath //cmd/hrcp-forgejo/queue)",
        "FORGEJO_SERVER": "$(rlocationpath @forgejo_test_server//file)",
        "FORGEJO_WORKER": "$(rlocationpath //cmd/hrcp-forgejo/worker)",
        "HRC_DAEMON": "$(rlocationpath //:hrcd)",
        "HRC_SPACE": "$(rlocationpath //:hrcm)",
        "NODE20": "$(rlocationpath @node20_linux_glibc_x64//:node_bin)",
        "NODE24": "$(rlocationpath @node24_linux_glibc_x64//:node_bin)",
    },
    legacy_create_init = False,
    main = "local.py",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# Exercises the real server, HRC IPC, scheduler and pgroup slot, not a mock API.
