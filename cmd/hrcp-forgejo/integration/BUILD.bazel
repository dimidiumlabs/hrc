        "FORGEJO_SERVER": "$(rlocationpath @forgejo_test_server//file)",
        "FORGEJO_WORKER": "$(rlocationpath //cmd/hrcp-forgejo/worker)",
        "HRC_DAEMON": "$(rlocationpath //:hrcd)",
        "HRC_SPACE": "$(rlocationpath //:hrcm)",
        "NODE20": "$(rlocationpath @node20_linux_glibc_x64//:node_bin)",
        "NODE24": "$(rlocationpath @node24_linux_glibc_x64//:node_bin)",
