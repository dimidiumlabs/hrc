+// WithNodeRuntimeResolver supplies the Node executable for JavaScript actions.
+// HRC uses this for host execution with bundled, version-specific runtimes.
+func WithNodeRuntimeResolver(ctx context.Context, resolve func(string) (string, error)) context.Context {
+	return context.WithValue(ctx, nodeRuntimeResolverKey{}, resolve)
+}
+
+type nodeRuntimeResolverKey struct{}
+
+func resolveNodeRuntime(ctx context.Context, using string) (string, error) {
+	if resolve, ok := ctx.Value(nodeRuntimeResolverKey{}).(func(string) (string, error)); ok {
+		return resolve(using)
+	}
+	return "node", nil
+}
