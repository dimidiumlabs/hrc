load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("//tools/check:sources.bzl", "check_sources")

check_sources()

copy_file(
    name = "runner_version",
    src = "@actions_runner//:runnerversion",
    out = "runner-version.txt",
)

go_library(
    name = "queue_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    embedsrcs = ["runner-version.txt"],
    importpath = "dimidiumlabs.io/hrc/cmd/hrcp-github/queue",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd/hrcp-github/queue/internal/job",
        "//cmd/hrcp-github/queue/internal/listener",
        "//internal/config",
        "//internal/provider",
        "//internal/runtime",
        "@com_github_actions_scaleset//:scaleset",
        "@com_github_golang_jwt_jwt_v5//:jwt",
    ],
)

go_binary(
    name = "hrcp-github-queue",
    embed = [":queue_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "queue_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":queue_lib"],
    deps = [
        "//cmd/hrcp-github/queue/internal/listener",
        "//internal/config",
        "//internal/provider",
        "@com_github_actions_scaleset//:scaleset",
        "@com_github_golang_jwt_jwt_v5//:jwt",
    ],
)

pkg_files(
    name = "queue_files",
    srcs = [":hrcp-github-queue"],
    attributes = pkg_attributes(mode = "0755"),
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//cmd/hrcp-github:__pkg__"],
)
