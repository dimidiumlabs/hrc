load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/check:sources.bzl", "check_sources")

check_sources()

go_library(
    name = "listener",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/cmd/hrcp-github/queue/internal/listener",
    visibility = ["//cmd/hrcp-github/queue:__subpackages__"],  # keep
    deps = [
        "@org_golang_x_oauth2//:oauth2",
        "@org_golang_x_oauth2//clientcredentials",
    ],
)

go_test(
    name = "listener_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":listener"],
)
