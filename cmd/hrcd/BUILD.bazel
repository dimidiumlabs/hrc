load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/check:sources.bzl", "check_sources")

check_sources()

exports_files(
    ["pkg/hrc.json"],
    visibility = ["//cmd:__pkg__"],
)

go_library(
    name = "hrcd_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/cmd/hrcd",
    visibility = ["//:__pkg__"],  # keep
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/provider-github",
        "//internal/runtime",
        "//internal/slot-pgroup",
        "//internal/space",
        "//internal/space-host",
    ],
)

go_binary(
    name = "hrcd",
    embed = [":hrcd_lib"],
    gc_linkopts = [
        "-s",
        "-w",
    ],  # keep
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "hrcd_test",
    size = "small",
    srcs = glob(["*_test.go"]),  # keep
    embed = [":hrcd_lib"],
    deps = [
        "//internal/config",
        "//internal/provider",
        "//internal/slot",
        "//internal/space",
    ],
)
