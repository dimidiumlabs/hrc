load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools:platforms.bzl", "ARCH", "OS")
load("//tools/rules_service:service.bzl", "service")

exports_files(["BUILD.bazel"])

go_library(
    name = "hrcd_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/cmd/hrcd",
    visibility = ["//:__pkg__"],  # keep
    deps = [
        "//internal/controller",
        "//internal/provider-github",
        "//internal/scheduler",
        "//internal/slot-pgroup",
        "//internal/space",
        "//internal/space-host",
        "@com_github_actions_scaleset//:scaleset",
    ],
)

go_binary(
    name = "hrcd",
    embed = [":hrcd_lib"],
    gc_linkopts = [
        "-s",
        "-w",
    ],  # keep
    pure = "on",
    visibility = ["//visibility:public"],
    x_defs = {"dimidiumlabs.io/hrc/cmd/hrcd.Version": "{STABLE_HRC_VERSION}"},
)

go_test(
    name = "hrcd_test",
    size = "small",
    srcs = glob(["*_test.go"]),  # keep
    embed = [":hrcd_lib"],
)

service(
    name = "release",
    service = "hrc",
    description = "Hosted Runner Controller",
    deps = [
        "//:docs_sources",
        "//:licenses",
        "//internal/provider-github/worker:runner",
    ],
    os = OS,
    arch = ARCH,
    bin = ":hrcd",
    executable = "hrcd",
    args = [
        "-config",
        "{config}",
    ],
    config = "pkg/hrc.json",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
