{
  "instanceId": "build-01",
  "directories": {
    "logs": "",
    "spaces": "",
    "runtime": ""
  },
  "spaces": [
    {
      "id": "build",
      "type": "host"
    }
  ],
  "slots": [
    {
      "id": "build-slots",
      "space": "build",
      "type": "pgroup",
      "quota": {
        "cpu": 2,
        "memory": "4GiB"
      },
      "ephemeral": true
    }
  ],
  "forges": [
    {
      "id": "hrc-builds",
      "type": "github",
      "url": "https://github.com/mrdimidium/hrc",
      "group": "default",
      "labels": [
        "linux",
        "X64"
      ],
      "pat": {
        "type": "env",
        "value": "GITHUB_TOKEN"
      },
      "slot": "build-slots"
    }
  ]
}
