load("//tools:platforms.bzl", "ARCH", "OS")
load("//tools/check:sources.bzl", "check_sources")
load("//tools/rules_service:service.bzl", "service")

check_sources()

service(
    name = "release",
    service = "hrc",
    description = "Hosted Runner Controller",
    deps = [
        "//:docs_sources",
        "//:licenses",
        "//cmd/hrcm",
        "//cmd/hrcp-github",
    ],
    os = OS,
    arch = ARCH,
    bin = "//cmd/hrcd:hrcd",
    executable = "hrcd",
    privileged = True,
    args = [
        "-config",
        "{config}",
    ],
    config = "//cmd/hrcd:pkg/hrc.json",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
