load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@gazelle//:def.bzl", "gazelle")
load("//tools:tools.bzl", "docs_archive")
load("//tools/check:formatters.bzl", "repository_format")
load("//tools/check:linter.bzl", "buildifier_test", "shellcheck_test")
load("//tools/check:sources.bzl", "check_sources")

check_sources(
    bazel = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    deps = [
        "//ansible",
        "//cmd",
        "//cmd/hrcd",
        "//cmd/hrcm",
        "//cmd/hrcp-github",
        "//internal/config",
        "//internal/provider",
        "//internal/resource",
        "//internal/runtime",
        "//internal/slot",
        "//internal/slot-pgroup",
        "//internal/space",
        "//internal/space-host",
        "//tools",
    ],
)

exports_files(["LICENSE"])

exports_files(
    ["dist/release/VERSION"],
    visibility = ["//ansible:__pkg__"],
)

bool_flag(
    name = "bundled-dotnet",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "docs_sources",
    srcs = glob(
        ["docs/**/*.rst"],
        exclude = ["docs/draft/**"],
    ),
    visibility = ["//cmd:__pkg__"],
)

repository_format(
    name = "format",
    srcs = [":check_sources"],
)

buildifier_test(
    name = "lint_starlark",
    srcs = [":bazel_sources"],
    size = "small",
)

shellcheck_test(
    name = "lint_shell",
    srcs = [":sh_sources"],
    size = "small",
)

test_suite(
    name = "lint",
    tests = [
        ":lint_shell",
        ":lint_starlark",
    ],
)

alias(
    name = "docs-dev",
    actual = "//tools:site_dev",
)

docs_archive(
    name = "docs",
    srcs = glob(
        [
            "docs/**/*.rst",
            "LICENSES/*.txt",
        ],
        exclude = ["docs/draft/**"],
    ) + ["//tools:site_theme"],
    conf = "//tools:site/conf.py",
    visibility = ["//tools:__pkg__"],
)

filegroup(
    name = "licenses",
    srcs = ["LICENSE"] + glob(["LICENSES/*"]),
    visibility = ["//cmd:__pkg__"],
)

# Inputs staged by CI's release matrix, not rebuilt across operating systems.
filegroup(
    name = "ansible_release_artifacts",
    # VERSION is optional outside the release job, like the tarballs.
    # buildifier: disable=constant-glob
    srcs = glob(
        [
            "dist/release/VERSION",
            "dist/release/hrc-*.tar.gz",
        ],
        exclude = ["dist/release/hrc-docs-*.tar.gz"],
        allow_empty = True,
    ),
    visibility = ["//ansible:__pkg__"],
)

# gazelle:prefix dimidiumlabs.io/hrc
# gazelle:resolve go dimidiumlabs.io/hrc/internal/provider //internal/provider
# gazelle:resolve go dimidiumlabs.io/hrc/internal/space //internal/space
# gazelle:exclude dist

gazelle(name = "gazelle")

test_suite(
    name = "tests",
    tests = [
        "//ansible:collection_test",
        "//cmd/hrcd:hrcd_test",
        "//cmd/hrcm:hrcm_test",
        "//cmd/hrcp-github:test",
        "//internal/config:config_test",
        "//internal/provider:provider_test",
        "//internal/resource:resource_test",
        "//internal/runtime:runtime_test",
        "//internal/slot-pgroup:slot-pgroup_test",
        "//internal/space:space_test",
        "//internal/space-host:space-host_test",
        "//tools:requirements.test",
        "//tools:site_test",
        "//tools/rules_ansible:collection_test",
        "//tools/rules_ansible:requirements.test",
        "//tools/rules_service:scripts_test",
    ],
)

alias(
    name = "runner",
    actual = "//cmd/hrcp-github/worker:runner",
    tags = ["manual"],
)

alias(
    name = "hrcd",
    actual = "//cmd/hrcd:hrcd",
    visibility = ["//visibility:public"],
)

alias(
    name = "hrcm",
    actual = "//cmd/hrcm:hrcm",
    visibility = ["//visibility:public"],
)
